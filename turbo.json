{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "15",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["db:generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "generated/**/*"],
      "env": [
        "DATABASE_URL",
        "NODE_ENV",
        "API_INTERNAL_URL",
        "NEXT_PUBLIC_API_URL",
        "BETTER_AUTH_SECRET",
        "STRIPE_SECRET_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN"
      ]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "env": [
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXT_PUBLIC_BASE_URL",
        "API_INTERNAL_URL",
        "NODE_ENV",
        "LOG_LEVEL",
        "SERVICE_NAME",
        "SERVICE_VERSION",
        "GIT_SHA",
        "POD_NAME",
        "PORT",
        "ALLOWED_ORIGINS",
        "CORS_ALLOW_MISSING_ORIGIN",
        "BETTER_AUTH_URL",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PRICE_ID_PRO_MONTHLY",
        "STRIPE_PRICE_ID_PRO_YEARLY",
        "RESEND_TOKEN",
        "RESEND_EMAIL_FROM",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "REDIS_URL"
      ]
    },
    "start": {
      "cache": false
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    }
  }
}
